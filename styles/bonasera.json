{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Bonasera",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#0D0D0D",
					"name": "Primario Bonasera",
					"slug": "vicunav-primary"
				},
				{
					"color": "#4A3B33",
					"name": "Secundario Bonasera",
					"slug": "vicunav-secondary"
				},
				{
					"color": "#9DAAAA",
					"name": "Acento Bonasera",
					"slug": "vicunav-accent"
				},
				{
					"color": "#4D673B",
					"name": "Positivo Bonasera",
					"slug": "vicunav-positive"
				},
				{
					"color": "#9F4527",
					"name": "Advertencia Bonasera",
					"slug": "vicunav-warning"
				},
				{
					"color": "#A8432B",
					"name": "Peligro Bonasera",
					"slug": "vicunav-danger"
				},
				{
					"color": "#557259",
					"name": "Información Bonasera",
					"slug": "vicunav-info"
				},
				{
					"color": "#FAEBD7",
					"name": "Crema Bonasera",
					"slug": "vicunav-neutral-100"
				},
				{
					"color": "#F0DFC4",
					"name": "Crema tenue Bonasera",
					"slug": "vicunav-neutral-200"
				},
				{
					"color": "#FFFDF8",
					"name": "Papel Bonasera",
					"slug": "vicunav-neutral-300"
				},
				{
					"color": "rgba(13, 13, 13, 0.12)",
					"name": "Tinta 12% Bonasera",
					"slug": "vicunav-neutral-400"
				},
				{
					"color": "rgba(13, 13, 13, 0.5)",
					"name": "Tinta 50% Bonasera",
					"slug": "vicunav-neutral-500"
				},
				{
					"color": "rgba(13, 13, 13, 0.62)",
					"name": "Tinta 62% Bonasera",
					"slug": "vicunav-neutral-600"
				},
				{
					"color": "rgba(13, 13, 13, 0.75)",
					"name": "Tinta 75% Bonasera",
					"slug": "vicunav-neutral-700"
				},
				{
					"color": "#4A3B33",
					"name": "Marrón malta Bonasera",
					"slug": "vicunav-neutral-800"
				},
				{
					"color": "#0D0D0D",
					"name": "Tinta Bonasera",
					"slug": "vicunav-neutral-900"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "77.5rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "rem", "%", "vw"],
			"spacingSizes": [
				{
					"name": "Bonasera 1",
					"size": "0.25rem",
					"slug": "bonasera-space-1"
				},
				{
					"name": "Espacio XS",
					"size": "0.5rem",
					"slug": "vicunav-space-xs"
				},
				{
					"name": "Bonasera 3",
					"size": "0.75rem",
					"slug": "bonasera-space-3"
				},
				{
					"name": "Espacio SM",
					"size": "1rem",
					"slug": "vicunav-space-sm"
				},
				{
					"name": "Espacio MD",
					"size": "1.5rem",
					"slug": "vicunav-space-md"
				},
				{
					"name": "Espacio LG",
					"size": "2rem",
					"slug": "vicunav-space-lg"
				},
				{
					"name": "Espacio XL",
					"size": "3rem",
					"slug": "vicunav-space-xl"
				},
				{
					"name": "Bonasera 8",
					"size": "4rem",
					"slug": "bonasera-space-8"
				},
				{
					"name": "Bonasera 9",
					"size": "6rem",
					"slug": "bonasera-space-9"
				},
				{
					"name": "Bonasera 10",
					"size": "8.75rem",
					"slug": "bonasera-space-10"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Tarjeta Bonasera",
					"shadow": "0 10px 22px rgba(13, 13, 13, 0.16)",
					"slug": "bonasera-card"
				},
				{
					"name": "Tarjeta elevada Bonasera",
					"shadow": "0 20px 40px rgba(13, 13, 13, 0.24)",
					"slug": "bonasera-card-hover"
				},
				{
					"name": "Modal Bonasera",
					"shadow": "0 30px 70px rgba(13, 13, 13, 0.35)",
					"slug": "bonasera-modal"
				},
				{
					"name": "Panel lateral Bonasera",
					"shadow": "-12px 0 40px rgba(13, 13, 13, 0.25)",
					"slug": "bonasera-drawer"
				},
				{
					"name": "Aviso Bonasera",
					"shadow": "0 12px 30px rgba(13, 13, 13, 0.3)",
					"slug": "bonasera-toast"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "Big Shoulders Display",
							"fontStyle": "normal",
							"fontWeight": "700 900",
							"src": "file:./assets/fonts/big-shoulders-display-latin.woff2"
						}
					],
					"fontFamily": "\"Big Shoulders Display\", sans-serif",
					"name": "Encabezados Bonasera",
					"slug": "vicunav-heading"
				},
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": "file:./assets/fonts/jost-latin.woff2"
						}
					],
					"fontFamily": "Jost, sans-serif",
					"name": "Cuerpo Bonasera",
					"slug": "vicunav-body"
				}
			],
			"fontSizes": [
				{
					"name": "Micro Bonasera",
					"size": "0.6875rem",
					"slug": "bonasera-xs"
				},
				{
					"name": "Pequeño Vicunav",
					"size": "0.78125rem",
					"slug": "vicunav-sm"
				},
				{
					"name": "Base Bonasera",
					"size": "0.875rem",
					"slug": "bonasera-base"
				},
				{
					"name": "Mediano Vicunav",
					"size": "0.9375rem",
					"slug": "vicunav-md"
				},
				{
					"name": "Grande Vicunav",
					"size": "1.1875rem",
					"slug": "vicunav-lg"
				},
				{
					"name": "Grande Bonasera",
					"size": "1.375rem",
					"slug": "bonasera-xl"
				},
				{
					"name": "Extra grande Bonasera",
					"size": "1.625rem",
					"slug": "bonasera-xxl"
				},
				{
					"fluid": false,
					"name": "Display Vicunav",
					"size": "clamp(2.25rem, 5vw, 3.375rem)",
					"slug": "vicunav-xl"
				}
			]
		},
		"custom": {
			"bonasera": {
				"border": {
					"hairline": "rgba(13, 13, 13, 0.12)",
					"hairlineInverse": "rgba(250, 235, 215, 0.12)",
					"onInverse": "rgba(250, 235, 215, 0.4)",
					"onPage": "rgba(13, 13, 13, 0.35)",
					"option": "rgba(13, 13, 13, 0.2)",
					"optionUnavailable": "rgba(13, 13, 13, 0.25)"
				},
				"breakpoint": {
					"large": "1024px",
					"medium": "768px",
					"small": "480px",
					"wide": "1440px"
				},
				"container": {
					"max": "1240px"
				},
				"motion": {
					"durationBase": "0.25s",
					"durationFast": "0.2s",
					"durationSlow": "0.5s",
					"easeStandard": "cubic-bezier(0.2, 0.7, 0.2, 1)"
				},
				"opacity": {
					"hairline": "0.08",
					"muted": "0.35",
					"strong": "0.75",
					"subtle": "0.55"
				},
				"radius": {
					"circle": "50%",
					"none": "0",
					"pill": "999px"
				},
				"sectionSpacing": {
					"inline": "clamp(1.5rem, 5vw, 6rem)",
					"vertical": "clamp(4rem, 10vw, 8.75rem)"
				},
				"shadow": {
					"card": "0 10px 22px rgba(13, 13, 13, 0.16)",
					"cardHover": "0 20px 40px rgba(13, 13, 13, 0.24)",
					"drawer": "-12px 0 40px rgba(13, 13, 13, 0.25)",
					"modal": "0 30px 70px rgba(13, 13, 13, 0.35)",
					"toast": "0 12px 30px rgba(13, 13, 13, 0.3)"
				},
				"surface": {
					"cardDark": "var(--wp--preset--color--vicunav-neutral-900)",
					"cardLight": "var(--wp--preset--color--vicunav-neutral-200)",
					"chipOnInverse": "rgba(250, 235, 215, 0.12)",
					"chipOnInverseHover": "rgba(250, 235, 215, 0.18)",
					"inverse": "var(--wp--preset--color--vicunav-neutral-900)",
					"page": "var(--wp--preset--color--vicunav-neutral-100)",
					"tinted": "var(--wp--preset--color--vicunav-neutral-200)"
				},
				"text": {
					"faintOnInverse": "rgba(250, 235, 215, 0.5)",
					"faintOnPage": "rgba(13, 13, 13, 0.5)",
					"mutedOnInverse": "rgba(250, 235, 215, 0.6)",
					"mutedOnPage": "rgba(13, 13, 13, 0.55)",
					"onInverse": "var(--wp--preset--color--vicunav-neutral-100)",
					"onPage": "var(--wp--preset--color--vicunav-neutral-900)",
					"secondaryOnInverse": "rgba(250, 235, 215, 0.85)",
					"secondaryOnPage": "rgba(13, 13, 13, 0.75)",
					"tertiaryOnInverse": "rgba(250, 235, 215, 0.72)",
					"tertiaryOnPage": "rgba(13, 13, 13, 0.62)"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--vicunav-neutral-100)",
			"text": "var(--wp--preset--color--vicunav-neutral-900)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--vicunav-space-md)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--bonasera--radius--pill)",
					"style": "solid",
					"width": "1.5px"
				},
				"css": "min-height: 44px; transition: opacity var(--wp--custom--bonasera--motion--duration-fast) ease, background-color var(--wp--custom--bonasera--motion--duration-fast) ease; &:hover { opacity: 0.72; }",
				"color": {
					"background": "var(--wp--preset--color--vicunav-primary)",
					"text": "var(--wp--preset--color--vicunav-neutral-100)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.875rem",
						"left": "1.625rem",
						"right": "1.625rem",
						"top": "0.875rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--vicunav-body)",
					"fontSize": "var(--wp--preset--font-size--bonasera-base)",
					"fontWeight": "700",
					"letterSpacing": "0.03em",
					"textTransform": "uppercase"
				},
				":focus": {
					"outline": {
						"color": "transparent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					},
					"shadow": "0 0 0 2px var(--wp--preset--color--vicunav-neutral-900), 0 0 0 5px var(--wp--preset--color--vicunav-neutral-100)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--vicunav-primary)",
						"text": "var(--wp--preset--color--vicunav-neutral-100)"
					}
				}
			},
			"h1": {
				"css": "transform: scaleY(1.22);"
			},
			"h2": {
				"css": "transform: scaleY(1.22);"
			},
			"h3": {
				"css": "transform: scaleY(1.22);"
			},
			"h4": {
				"css": "transform: scaleY(1.22);"
			},
			"h5": {
				"css": "transform: scaleY(1.22);"
			},
			"h6": {
				"css": "transform: scaleY(1.22);"
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
					"fontWeight": "800",
					"letterSpacing": "0.01em",
					"lineHeight": "0.95",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--vicunav-primary)"
				},
				":focus": {
					"outline": {
						"color": "transparent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					},
					"shadow": "0 0 0 2px var(--wp--preset--color--vicunav-neutral-900), 0 0 0 5px var(--wp--preset--color--vicunav-neutral-100)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--vicunav-secondary)"
					}
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vicunav-body)",
			"fontSize": "var(--wp--preset--font-size--vicunav-md)",
			"lineHeight": "1.5"
		},
		"blocks": {
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--vicunav-space-xs)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--bonasera--radius--none)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--vicunav-body)",
					"fontSize": "var(--wp--preset--font-size--bonasera-base)",
					"fontWeight": "600",
					"letterSpacing": "0.03em",
					"textTransform": "uppercase"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
					"fontSize": "var(--wp--preset--font-size--vicunav-lg)",
					"fontWeight": "800",
					"letterSpacing": "0.01em",
					"lineHeight": "0.86",
					"textTransform": "uppercase"
				}
			}
		}
	}
}
