			]
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "80rem"
		},
		"custom": {
			"vicunav": {
				"border": {
					"width": {
						"thin": "1px",
						"regular": "2px"
					}
				},
				"breakpoint": {
					"small": "480px",
					"medium": "768px",
					"large": "1024px",
					"wide": "1440px"
				},
				"container": {
					"max": "1200px"
				},
				"motion": {
					"duration": {
						"fast": "120ms",
						"base": "200ms",
						"slow": "320ms"
					}
				},
				"opacity": {
					"subtle": "0.08",
					"muted": "0.5",
					"strong": "0.75"
				},
				"radius": {
					"none": "0px",
					"sm": "4px",
					"md": "8px",
					"lg": "16px",
					"pill": "999px"
				},
				"surface": {
					"overlayLight": "rgba(255, 255, 255, 0.6)",
					"overlayDark": "rgba(15, 23, 42, 0.6)"
				},
				"text": {
					"mutedOpacity": "0.62"
				},
				"section": {
					"paddingBlock": "clamp(2rem, 6vw, 5rem)",
					"paddingInline": "clamp(1rem, 4vw, 3rem)"
				}
			}
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--vicunav-space-md)"
		}
	}
